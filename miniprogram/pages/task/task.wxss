/* task.wxss - 任务详情页样式 */

page {
  --td-picker-title-font: 600 32rpx / 48rpx sans-serif;
  --td-picker-button-font: 28rpx / 44rpx sans-serif;
  --td-picker-item-font-size: 28rpx;
  --td-picker-bg-color: var(--bg-card);
  --td-picker-title-color: var(--text-primary);
  --td-picker-cancel-color: var(--text-secondary);
  --td-picker-confirm-color: var(--primary);
  --td-textarea-padding: 0;
  --td-textarea-background-color: var(--bg-card);

  height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
  /* TDesign Navbar 变量 - 响应主题 */
  --td-navbar-bg-color: var(--bg-card);
  --td-navbar-color: var(--text-primary);
}

/* 主题容器 - 不影响布局 */
.container-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============================================
   导航栏
   ============================================ */
.nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  height: 88rpx;
  box-sizing: border-box;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-light);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.back-btn {
  position: absolute !important;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-primary) !important;
  cursor: pointer;
  z-index: 10;
  width: 72rpx;
  height: 72rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: background-color 0.2s ease;
}

.back-btn:active {
  background-color: var(--bg-input);
}

/* ============================================
   Swiper 组件
   ============================================ */
.swiper-component {
  width: 100%;
  flex: 1;
  min-height: 0;
  height: 0;
}

swiper-item {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.scroll {
  flex: 1;
  overflow: auto;
  padding-bottom: 60rpx;
}

/* ============================================
   头部信息区
   ============================================ */
.header {
  padding: 24rpx 32rpx;
  color: var(--text-primary);
  flex-shrink: 0;
  text-align: center;
}

/* 固定在顶部的 header-word */
.header-word-fixed {
  position: sticky;
  top: 0;
  z-index: 100;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  word-wrap: break-word;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-top: 52rpx;
  padding: 50rpx 32rpx;
  min-height: auto;
  display: block;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background-color: rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
}

.header-subtitle {
  font-size: 32rpx;
  flex-shrink: 0;
  text-align: center;
  margin: 20rpx 0;
  color: var(--text-secondary);
  line-height: 1.6;
}

.header-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
}

.source {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(74, 124, 243, 0.1);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
}

.source-name {
  width: 55%;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ============================================
   表单组
   ============================================ */
.group-wrapper {
  margin: 0 12rpx 16rpx;
  border-radius: var(--radius-lg);
  padding: 16rpx;
  box-shadow: var(--shadow-sm)
}


.custom-cell {
  background-color: var(--bg-card) !important;
  color: var(--text-primary) !important;
  border-radius: var(--radius-lg) !important;
  border: none !important;
  min-height: 96rpx; /* iPad */
}

.custom-cell::after {
  border: none !important;
}

/* ============================================
   TDesign Collapse 样式
   ============================================ */
.t-collapse {
  margin: 0 24rpx;
}

.t-collapse-panel {
  margin-bottom: 16rpx !important;
  border-radius: var(--radius-lg) !important;
  overflow: hidden !important;
  background-color: var(--bg-card) !important;
  border: none !important;
}

.t-collapse-panel::after,
.t-collapse-panel::before {
  display: none !important;
}

.t-collapse-panel__header {
  background-color: var(--bg-card) !important;
  color: var(--text-primary) !important;
  font-weight: 600 !important;
  padding: 16rpx 24rpx !important;
  border-bottom: none !important;
  font-size: 32rpx !important;
}

.t-collapse-panel__header::after {
  display: none !important;
}

.t-collapse-panel__content {
  background-color: var(--bg-input) !important;
  padding: 16rpx 0 !important;
  border: none !important;
}

.t-collapse-panel__content::after {
  display: none !important;
}

/* ============================================
   底部按钮
   ============================================ */
.footer {
  position: static;
  margin-top: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 144rpx;
  padding: 16rpx 32rpx 24rpx;
  box-sizing: border-box;
  background-color: transparent;
  border-top: none;
  --td-button-large-height: 96rpx;
}

.btn-cancel,
.btn-submit {
  flex: 1;
  min-width: 0;
  width: 0;
}

/* 取消按钮 */
.btn-cancel-inner {
  background-color: var(--bg-input) !important;
  border: 1px solid var(--border-color) !important;
  color: var(--text-secondary) !important;
  border-radius: var(--radius-full) !important;
}

.btn-cancel-inner .t-button__text {
  font-size: 32rpx !important;
}

/* 确认按钮 */
.btn-submit-inner {
  background: var(--gradient-primary) !important;
  border: none !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  box-shadow: var(--shadow-primary) !important;
}

.btn-submit-inner .t-button__text {
  font-size: 32rpx !important;
}

.btn-submit-inner.t-button--disabled {
  opacity: 0.5 !important;
  box-shadow: none !important;
}

/* ============================================
   滑动指示器
   ============================================ */
.custom-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48rpx 0 0;
  gap: 16rpx;
  background-color: var(--bg-page);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: var(--border-color);
  border-radius: var(--radius-full);
  opacity: 0.6;
  transform: scale(1);
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

.dot.active {
  width: 40rpx;
  opacity: 1;
  background: var(--gradient-primary);
  transform: scale(1.1);
}

.add-icon {
  margin-left: 16rpx;
  color: var(--primary) !important;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.add-icon:active {
  opacity: 1;
}

.hide {
  display: none;
}

/* ============================================
   提示信息
   ============================================ */
.info-text {
  padding: 16rpx 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  background-color: var(--bg-page);
}

.info-message {
  margin-left: 12rpx;
  font-size: 26rpx;
}

/* ============================================
   新增按钮
   ============================================ */
.btn-add-group {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  padding: 0 32rpx;
}

.btn-add-group .t-button {
  flex: 1;
  max-width: 280rpx;
}

.btn-add-group .t-button .t-button__text {
  font-size: 32rpx !important;
}

.add-item-icon {
  color: #fff !important;
  margin-right: 8rpx;
}

/* ============================================
   弹出层
   ============================================ */
.popup-container {
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  color: var(--text-primary);
}

.popup-title {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.popup-container .t-cell {
  background-color: var(--bg-input) !important;
  margin-bottom: 12rpx !important;
  border-radius: var(--radius-md) !important;
}

.info-icon {
  color: var(--text-muted) !important;
}

/* ============================================
   长按添加区域
   ============================================ */
.flex {
  display: flex;
  align-items: center;
  justify-content: center;
}

.longpress-view {
  width: 60%;
  min-height: 60rpx;
  background: var(--gradient-primary);
  border: none;
  border-radius: var(--radius-full);
  margin: 20rpx 0;
  color: #fff;
  text-align: center;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-primary);
  padding: 16rpx 32rpx;
  font-weight: 500;
}

.longpress-view:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ============================================
   删除图标
   ============================================ */
.delete-icon {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(239, 68, 68, 0.1);
  color: var(--danger) !important;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.delete-icon:active {
  background: rgba(239, 68, 68, 0.2);
  transform: scale(0.9);
}

/* 深色模式下删除图标 */
@media (prefers-color-scheme: dark) {
  .delete-icon {
    background: rgba(239, 68, 68, 0.15);
  }

  .delete-icon:active {
    background: rgba(239, 68, 68, 0.25);
  }
}

.field-class {
  width: 100rpx;
  min-width: 150rpx;
  white-space: nowrap;
}

/* 伪元素添加明显红色星号 - 放在左边 */
.field-class::before {
  content: "*";
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 900;
  margin-right: 6rpx;
}

/* ============================================
   音频组件
   ============================================ */
.audio-container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  padding: 0;
  min-height: 0;
}

.audio-label {
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  font-weight: 400;
  line-height: 1.6;
}

.audio-content {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audio-controls {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 录音按钮 */
.record-btn {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-full);
  padding: 0 16rpx;
  min-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s ease;
}

.record-btn:active {
  background-color: var(--border-light);
}

.record-btn.recording {
  background: var(--success);
  border-color: var(--success);
  transform: scale(1.02);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.record-btn.recording .mic-icon {
  color: #fff !important;
}

.record-btn.recording .record-text {
  color: #fff;
}

.mic-icon {
  color: var(--text-secondary) !important;
  font-size: 32rpx;
  display: flex;
  align-items: center;
}

.record-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}

.audio-icon {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-full);
  padding: 16rpx;
}

.audio-delete {
  flex-shrink: 0;
  text-align: right;
  padding-left: 16rpx;
}

/* ============================================
   Dark Mode - System Preference
   ============================================ */
@media (prefers-color-scheme: dark) {
  page {
    --td-navbar-bg-color: #161b22;
    --td-navbar-color: #f0f6fc;
  }

  .header {
    color: var(--text-primary);
  }

  .header-word {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .header-word-fixed {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-color: rgba(22, 27, 34, 0.8);
  }

  .header-option {
    background-color: var(--bg-card);
    border-color: var(--border-color);
  }
  
  .custom-cell {
    background-color: var(--bg-card) !important;
    border-color: var(--border-color) !important;
  }
  
  .popup-container {
    background: var(--bg-card) !important;
  }

  .record-btn {
    background: var(--bg-input);
    border-color: var(--border-color);
  }

  .mic-icon {
    color: var(--text-secondary) !important;
  }

  .record-text {
    color: var(--text-secondary);
  }
  
  .back-btn {
    color: var(--text-primary);
  }
  
  .footer {
    background-color: transparent;
    border-top: none;
  }
  
  .t-collapse-panel {
    background-color: var(--bg-card) !important;
    border-color: var(--border-color) !important;
  }

  .delete-icon {
    background: rgba(239, 68, 68, 0.15);
  }
  
  .delete-icon:active {
    background: rgba(239, 68, 68, 0.25);
  }
}

/* ============================================
   Dark Mode - Manual Theme Toggle (.theme-dark)
   ============================================ */

/* 导航栏 */
.nav.theme-dark {
  background-color: rgba(22, 27, 34, 0.95);
  border-bottom-color: var(--border-color);
}

.nav.theme-dark .title {
  color: var(--text-primary);
}

.nav.theme-dark .back-btn {
  color: var(--text-primary) !important;
}

/* 头部区域 */
.header.theme-dark {
  color: var(--text-primary);
}

.header.theme-dark .header-word {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.header-word-fixed.theme-dark {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  background-color: var(--bg-page);
}

.header.theme-dark .header-subtitle {
  color: var(--text-secondary);
}

.header.theme-dark .header-option {
  background-color: var(--bg-card);
  border-color: var(--border-color);
}

.header.theme-dark .source {
  background: rgba(93, 140, 245, 0.15);
  color: var(--primary);
}

.header.theme-dark .source-name {
  color: var(--text-muted);
}

/* Swiper 区域 */
.swiper-component.theme-dark {
  background-color: var(--bg-page);
}

/* 底部区域 */
.footer.theme-dark {
  background-color: transparent;
  border-top: none;
}

.footer.theme-dark .btn-cancel-inner {
  background-color: var(--bg-input) !important;
  border-color: var(--border-color) !important;
  color: var(--text-secondary) !important;
}

.footer.theme-dark .btn-submit-inner {
  background: var(--gradient-primary) !important;
  color: #fff !important;
}

.footer.theme-dark .btn-cancel-inner .t-button__text,
.footer.theme-dark .btn-submit-inner .t-button__text {
  font-size: 32rpx !important;
}

/* 弹出层 */
.popup-container.theme-dark {
  background: var(--bg-card) !important;
  color: var(--text-primary);
}

.popup-container.theme-dark .popup-title {
  color: var(--text-primary);
}

.popup-container.theme-dark .t-cell {
  background-color: var(--bg-input) !important;
}

/* 提示信息 */
.info-text.theme-dark {
  color: var(--text-muted);
  background-color: #0D1117;
}

.info-text.theme-dark .info-message {
  color: var(--text-muted);
}

/* 指示点 */
.custom-dots.theme-dark {
  background-color: var(--bg-page);
}

.custom-dots.theme-dark .dot {
  background-color: var(--border-color);
}

.custom-dots.theme-dark .dot.active {
  background: var(--gradient-primary);
}

.custom-dots.theme-dark .add-icon {
  color: var(--primary) !important;
}

/* group-wrapper dark 模式阴影 */
.group-wrapper.theme-dark {
  box-shadow: var(--shadow-sm) !important;
}

/* 已完成状态的 group-wrapper 去除阴影和 padding，并调整边距与选项栏一致 */
.group-wrapper-no-style {
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0 32rpx 16rpx !important;
}

/* 任务详情：来源卡片、选项标题与可折叠内容 */
.scroll { min-height: 0; height: 0; box-sizing: border-box; }
.header { padding: 24rpx 24rpx 0; text-align: left; }
.header-option { display: flex; flex-direction: column; align-items: stretch; gap: 24rpx; margin-top: 0; padding: 24rpx; border: none; border-radius: 24rpx; }
.source-caption { color: var(--text-muted); font-size: 26rpx; }
.header-option .source-name { width: auto; text-align: left; color: var(--text-primary); font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.header-word-fixed { position: static; margin: 0; padding: 0; background: none; color: var(--text-secondary); font-size: 26rpx; font-weight: 400; text-align: left; line-height: 1.6; backdrop-filter: none; -webkit-backdrop-filter: none; }
.option-heading { margin: 24rpx; padding: 16rpx; background: var(--bg-input); border-radius: 16rpx; text-align: center; }
.option-heading .source { display: block; padding: 16rpx 16rpx; border-radius: 16rpx; background: var(--bg-card); color: var(--primary); font-size: 28rpx; }
.t-collapse { margin: 0 24rpx; }
.detail-card { margin-bottom: 24rpx !important; border: 2rpx solid var(--border-light) !important; border-radius: 24rpx !important; overflow: hidden; background: var(--bg-card); }
.detail-card-header { padding: 24rpx !important; font-size: 32rpx !important; font-weight: 700; background: var(--bg-card) !important; color: var(--text-primary) !important; }
.detail-card-content { padding: 0 24rpx 24rpx !important; background: var(--bg-card) !important; }
.group-wrapper { margin: 0; padding: 16rpx 0; border-radius: 0; box-shadow: none; border-bottom: 1rpx solid var(--border-light); }
.field-class { width: auto; min-width: 0; }
.field-class::before { font-size: 26rpx; font-weight: 500; }
.btn-add-group { display: block; margin-top: 28rpx; padding: 0 24rpx; }
.btn-add-group .t-button { width: 100%; max-width: none; }

/* 同时展示实际返回的所有选项，包括 LLM 建议 */
.option-heading { display: flex; flex-wrap: wrap; gap: 8rpx; padding: 8rpx; margin-bottom: 12rpx; }
.option-label { flex: 1; min-width: 200rpx; padding: 16rpx 16rpx; box-sizing: border-box; border-radius: 16rpx; color: var(--text-muted); font-size: 28rpx; line-height: 1.5; text-align: center; }
.option-label-active { background: var(--bg-card); color: var(--primary); font-weight: 600; }
.option-swipe-hint { margin: 0 24rpx 24rpx; color: var(--text-muted); font-size: 24rpx; line-height: 1.5; }

/* 来源和选项栏常驻，仅下方内容滚动 */
.header, .option-heading, .option-swipe-hint { flex-shrink: 0; }
.source-category { color: var(--text-muted); font-size: 26rpx; line-height: 1.6; }
.scroll { padding-top: 8rpx; }

.editable-field { position: relative; }
.field-edit-hint { position: absolute; top: 0; right: 0; z-index: 1; color: var(--text-muted); font-size: 24rpx; }
.field-edit-description { color: var(--text-muted); font-size: 26rpx; margin: 0 0 12rpx; line-height: 1.6; }
.field-editor { padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--bg-card); color: var(--text-primary); border-radius: 32rpx 32rpx 0 0; }
.field-editor-handle { width: 72rpx; height: 8rpx; margin: 0 auto 36rpx; background: var(--border-color); border-radius: 8rpx; }
.field-editor-title { font-size: 32rpx; font-weight: 700; }
.field-editor-description { margin: 24rpx 0 40rpx; color: var(--text-muted); font-size: 26rpx; line-height: 1.6; }
.field-editor-input { width: 100%; height: 220rpx; padding: 24rpx; box-sizing: border-box; border: 2rpx solid var(--border-light); border-radius: 16rpx; background: var(--bg-card); color: var(--text-primary); font-size: 28rpx; line-height: 1.6; }
.field-editor-actions { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; --td-button-large-height: 96rpx; }
.field-editor-actions t-button { flex: 1; min-width: 0; }

/* 已处理详情的时间与状态 */
.completed-info-card { margin: 24rpx; padding: 8rpx 24rpx; border: 2rpx solid var(--border-light); border-radius: 24rpx; background: var(--bg-card); }
.completed-info-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 0; }
.completed-info-row + .completed-info-row { border-top: 1rpx solid var(--border-light); }
.completed-info-label { flex-shrink: 0; color: var(--text-muted); font-size: 26rpx; }
.completed-info-value { color: var(--text-primary); font-size: 26rpx; text-align: right; overflow-wrap: break-word; line-height: 1.6; }
.completed-info-status { color: var(--primary); background: var(--bg-input); padding: 8rpx 16rpx; border-radius: var(--radius-full); font-size: 24rpx; font-weight: 600; }

/* TDesign 字段与选择器统一排版 */
.task-field-cell {
  padding: 0 !important;
  background: transparent !important;
  align-items: flex-start !important;
  --td-cell-description-margin-top: 16rpx;
}
.task-field-label { color: var(--text-muted) !important; font-size: 26rpx !important; line-height: 44rpx; font-weight: 400; }
.task-field-note { align-self: flex-start; margin-top: 60rpx; padding-left: 16rpx; }
.task-field-required { color: var(--danger); }
.task-field-value { margin-top: 16rpx; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: break-word; color: var(--text-primary); }
.task-field-placeholder { color: var(--text-muted); }
.task-picker { border-radius: 32rpx 32rpx 0 0; overflow: hidden; }
.field-editor-textarea { height: 168rpx !important; font-size: 28rpx !important; line-height: 1.6 !important; color: var(--text-primary) !important; }

.classification-custom-entry { padding: 32rpx; background: var(--bg-card); }

.custom-classification-fields { display: flex; flex-direction: column; gap: 16rpx; margin: 32rpx 0; }
.custom-classification-label { font-size: 26rpx; color: var(--text-muted); }
.custom-classification-input { box-sizing: border-box; height: 88rpx; padding: 0 24rpx; border: 2rpx solid var(--border-light); border-radius: 16rpx; color: var(--text-primary); background: var(--bg-card); font-size: 28rpx; }

.task-tags { padding: 24rpx 0; border-top: 1rpx solid var(--border-light); }
.task-tags-heading { display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; color: var(--text-muted); }
.task-tag-add, .task-tag-confirm, .task-tag-create { color: var(--primary); }
.task-tag-chips { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; padding-top: 16rpx; }
.task-tag-chip { display: inline-flex; align-items: center; gap: 12rpx; min-height: 48rpx; box-sizing: border-box; padding: 8rpx 16rpx; border-radius: 8rpx; background: var(--bg-input); color: var(--primary); font-size: 24rpx; }
.task-tag-picker { padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--bg-card); color: var(--text-primary); }
.task-tag-picker-header { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0 32rpx; font-size: 28rpx; }
.task-tag-picker-title { font-size: 32rpx; font-weight: 600; }
.task-tag-cancel, .task-tag-selection { color: var(--text-muted); }
.task-tag-create { padding: 24rpx 0; font-size: 28rpx; overflow-wrap: anywhere; }
.task-tag-selection { padding: 24rpx 0 16rpx; font-size: 24rpx; }
.task-tag-options { height: 42vh; }
.task-tag-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx; margin-bottom: 16rpx; border-radius: 16rpx; background: var(--bg-input); font-size: 28rpx; overflow-wrap: anywhere; }
.task-tag-option-selected { color: var(--primary); }
.task-tag-empty { padding: 40rpx 0; text-align: center; color: var(--text-muted); font-size: 26rpx; }

.task-tag-edit-hint { font-size: 24rpx; color: var(--text-muted); }
.task-tag-empty-value { font-size: 28rpx; color: var(--text-muted); }

.option-label-number, .option-label-source { display: inline; }
.option-label-line { display: block; }

.task-action-borderless {
  border: none !important;
  --td-button-border-width: 0;
}

.task-rounded-popup, .task-rounded-popup-content { border-radius: 32rpx 32rpx 0 0; overflow: hidden; }

/* 覆盖全局 dark 模式对所有 t-icon 的颜色设置。 */
.theme-dark .add-icon.add-icon { color: var(--primary) !important; }
.field-editor-input { padding: 24rpx !important; }

.task-action-cancel {
  --td-button-border-width: 4rpx;
  --td-button-default-border-color: var(--border-color);
  --td-button-default-active-bg-color: var(--bg-input);
  background-color: var(--bg-input) !important;
  transition: none !important;
}
.task-action-cancel:active { background-color: var(--bg-input) !important; }

.task-tag-remove { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32rpx; height: 32rpx; }

.task-tag-draft { padding-top: 0; margin-bottom: 24rpx; }

.field-editor {
  --td-textarea-background-color: var(--bg-input);
  --td-textarea-text-color: var(--text-primary);
  --td-textarea-placeholder-color: var(--text-muted);
}
.field-editor .field-editor-input.field-editor-input {
  background: var(--bg-input) !important;
  color: var(--text-primary) !important;
}
.field-editor-button.field-editor-button {
  transition: none !important;
}
.field-editor-cancel.field-editor-cancel,
.field-editor-cancel.field-editor-cancel:active {
  background: var(--bg-input) !important;
  color: var(--text-secondary) !important;
}
.field-editor-save.field-editor-save,
.field-editor-save.field-editor-save:active {
  background: var(--gradient-primary) !important;
  color: #fff !important;
}
.theme-dark .field-editor-button.field-editor-button {
  --td-button-border-width: 0;
  border: none !important;
}
.theme-dark .field-editor-button.field-editor-button::after { border: none !important; }

.theme-dark .task-action-cancel.task-action-cancel,
.theme-dark .task-action-cancel.task-action-cancel:active {
  --td-button-border-width: 0;
  border: none !important;
  background: var(--bg-input) !important;
  color: var(--text-secondary) !important;
}
.theme-dark .task-action-cancel.task-action-cancel::after { border: none !important; }

.task-tag-picker {
  --td-search-bg-color: var(--bg-input);
  --td-search-text-color: var(--text-primary);
  --td-search-placeholder-color: var(--text-muted);
  --td-search-icon-color: var(--text-muted);
  --td-search-clear-icon-color: var(--text-muted);
}
.task-picker-theme {
  background: var(--bg-card);
  --td-picker-bg-color: var(--bg-card);
  --td-picker-title-color: var(--text-primary);
  --td-picker-cancel-color: var(--text-muted);
  --td-picker-confirm-color: var(--primary);
  --td-picker-item-color: var(--text-secondary);
  --td-picker-item-active-color: var(--text-primary);
  --td-picker-indicator-bg-color: var(--bg-input);
  --td-picker-transparent-color: transparent;
}
.classification-custom-button.classification-custom-button,
.classification-custom-button.classification-custom-button:active {
  background: var(--bg-input) !important;
  color: var(--text-primary) !important;
  transition: none !important;
}
.theme-dark .classification-custom-button.classification-custom-button {
  --td-button-border-width: 0;
  border: none !important;
}
.theme-dark .classification-custom-button.classification-custom-button::after { border: none !important; }

/* 弹窗本身包含安全区，使用与内容一致的背景。 */
.task-rounded-popup.task-rounded-popup,
.task-rounded-popup-content.task-rounded-popup-content,
.task-tag-picker.task-tag-picker {
  background-color: var(--bg-card) !important;
  --td-popup-bg-color: var(--bg-card);
}
.task-tag-picker.task-tag-picker { padding-bottom: 24rpx; }
.detail-card.detail-card { --td-collapse-border-color: transparent; }
.detail-card-header.detail-card-header::after { display: none !important; }

.field-editor.field-editor {
  background: var(--bg-card) !important;
  padding-bottom: 32rpx;
}
