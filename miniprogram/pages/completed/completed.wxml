<view class="container-wrap theme-{{currentTheme}}">
  <t-navbar title="已处理任务" left-arrow bind:go-back="onGoBack" />
  <view style="height: {{headerHeight}}px;"></view>
  <view class="page" style="min-height: calc(100vh - {{headerHeight}}px);">
      <task-list id="task-list"
        server-filtering="{{true}}"
        request-path="/task/completed"
        server-ready="{{listReady}}"
        initial-page="{{initialPage}}"
        header-height="{{headerHeight}}"
        current-theme="{{currentTheme}}"
        datasets="{{datasets}}"
        default-task-label="已处理任务"
        order-text="已处理任务"
        bind:tasktap="onClick"
      />
    <app-tab-bar value="mine" page="completed" />
  </view>

</view>

<common-dialog id="common-dialog" />
