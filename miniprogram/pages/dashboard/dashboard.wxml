<view class="container-wrap theme-{{currentTheme}}">
  <view class="fixed-header-wrapper">
    <view class="dashboard-task-types">
      <view wx:for="{{taskTypeOptions}}" wx:key="value" class="dashboard-task-type {{taskType === item.value ? 'dashboard-task-type-active' : ''}}" data-value="{{item.value}}" bind:tap="onTaskTypeChange" role="button" aria-pressed="{{taskType === item.value}}">{{item.label}}</view>
    </view>
    <view class="dashboard-filters">
      <view class="dashboard-filter" data-key="contentAttribute" bind:tap="onStatsFilterOpen"><text class="filter-label">内容类型</text><view class="filter-value"><text>{{contentAttributeText}}</text><t-icon name="chevron-down" size="28rpx" /></view></view>
      <view class="dashboard-filter" bindtap="onUserPicker"><text class="filter-label">用户</text><view class="filter-value"><text>{{userText}}</text><t-icon name="chevron-down" size="28rpx" /></view></view>
      <view class="dashboard-filter" bindtap="onDatasetPicker"><text class="filter-label">语料集</text><view class="filter-value"><text>{{datasetText}}</text><t-icon name="chevron-down" size="28rpx" /></view></view>
      <view class="dashboard-filter" data-key="categoryId" bind:tap="onStatsFilterOpen"><text class="filter-label">语料集分类</text><view class="filter-value"><text>{{categoryLoading ? '加载中…' : categoryText}}</text><t-icon name="chevron-down" size="28rpx" /></view></view>
    </view>
  </view>

  <!-- 可搜索的用户选择器 -->
  <view class="searchable-picker" wx:if="{{userVisible}}">
    <view class="picker-mask" bindtap="onUserPickerCancel"></view>
    <view class="picker-container">
      <view class="picker-header">
        <text class="picker-title">选择用户</text>
        <view class="picker-close" bindtap="onUserPickerCancel">
          <text class="close-icon">×</text>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="search-box">
        <view class="search-input-wrapper">
          <t-icon name="search" size="48rpx" color="inherit" />
          <input class="search-input" placeholder="搜索用户名称" value="{{userSearchKeyword}}" bindinput="onUserSearchInput"
            confirm-type="search" />
          <text class="clear-icon" wx:if="{{userSearchKeyword}}" bindtap="onClearUserSearch">✕</text>
        </view>
      </view>

      <!-- 选项列表 -->
      <scroll-view class="picker-options" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="option-list">
          <view class="option-item {{userValue === item.userId ? 'option-item-selected' : ''}}"
            wx:for="{{filteredUsers}}" wx:key="value" bindtap="onSelectUser" data-value="{{item.userId}}"
            data-label="{{item.username}}">
            <view class="option-content">
              <block wx:if="{{item.avatar}}">
                <t-image class="option-avatar" shape="circle" src="{{item.avatar}}" alt="{{item.username}}"
                  width="80rpx" height="80rpx" />
              </block>
              <block wx:else>
                <t-avatar class="option-avatar" shape="circle" size="small">{{item.username[0]}}</t-avatar>
              </block>
              <text class="option-label">{{item.username}}</text>
              <text class="option-check" wx:if="{{userValue === item.userId}}">✓</text>
            </view>
          </view>

          <!-- 无搜索结果 -->
          <view class="no-result" wx:if="{{filteredUsers.length === 0 && userSearchKeyword}}">
            <text class="no-result-text">未找到相关用户</text>
          </view>

          <!-- 无数据 -->
          <view class="no-result" wx:if="{{users.length === 0}}">
            <text class="no-result-text">暂无用户数据</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  <block wx:if="{{loading}}">
    <view class="content-wrapper">
      <task-list-skeleton variant="dashboard" show-overview="{{userValue === 'all'}}" />
    </view>
  </block>
  <block wx:else>
    <view class="content-wrapper">
      <block wx:if="{{hasTaskProgress}}">
      <view class="overview" wx:if="{{userValue === 'all'}}">
        <view class="section-heading"><text>任务概览</text><text class="section-caption">总语料 {{summary.totalCorpusCount}}</text></view>
        <view class="stats-grid">
          <view class="metric"><text class="metric-value">{{summary.totalCount}}</text><text class="metric-label">总任务</text></view>
          <view class="metric"><text class="metric-value metric-done">{{summary.processedCount}}</text><text class="metric-label">已处理</text></view>
          <view class="metric"><text class="metric-value">{{summary.unprocessedCount}}</text><text class="metric-label">未处理</text></view>
        </view>
        <view class="progress-heading"><text>整体完成率</text><text class="progress-value">{{summary.completionRate}}%</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{summary.completionRate}}%;"></view></view>
      </view>
      <view class="section-heading user-section"><text>用户进度</text></view>
      <view class="user-card" wx:for="{{items}}" wx:key="value" bindtap="onHandleUserTaskList" data-user-id="{{item.assigneeRef}}" data-dataset-name="{{item.corpusId}}">
        <view class="user-card-header">
          <view class="user-avatar"><t-image wx:if="{{item.assigneeRefAvatar}}" shape="circle" src="{{item.assigneeRefAvatar}}" width="72rpx" height="72rpx" /><t-avatar wx:else shape="circle" size="small">{{item.assigneeRefName[0]}}</t-avatar></view>
          <view class="user-info"><view class="user-name">{{item.assigneeRefName}}<text class="self-tag" wx:if="{{item.assigneeRef === currentUserId}}">自己</text></view><text class="user-corpus" wx:if="{{datasetValue === 'all'}}">{{item.corpusName}}</text></view>
          <t-icon name="chevron-right" size="32rpx" color="var(--text-muted)" />
        </view>
        <view class="user-metrics">
          <view><text class="user-metric-value">{{item.totalCount}}</text><text class="metric-label">总任务</text></view>
          <view><text class="user-metric-value metric-done">{{item.processedCount}}</text><text class="metric-label">已处理</text></view>
          <view><text class="user-metric-value">{{item.unprocessedCount}}</text><text class="metric-label">未处理</text></view>
        </view>
        <view class="progress-heading"><text>完成率</text><text class="progress-value">{{item.completionRate}}%</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{item.completionRate}}%;"></view></view>
      </view>
      </block>
      <view class="empty-state" wx:if="{{!hasTaskProgress || !items.length}}"><text class="empty-text">暂无任务进度</text></view>

    </view>
  </block>

  <t-popup visible="{{datasetVisible}}" placement="bottom" t-class="dashboard-rounded-popup" t-class-content="dashboard-rounded-popup-content" bind:visible-change="onPickerCancel">
  <t-picker use-popup="{{false}}" t-class="dashboard-picker" style="--td-picker-border-radius: 32rpx;" visible="{{datasetVisible}}" value="{{datasetValue}}" data-key="dataset" title="选择语料集" cancelBtn="取消"
    confirmBtn="确认" usingCustomNavbar bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
    <t-picker-item options="{{datasets}}"></t-picker-item>
  </t-picker>
  </t-popup>
  <t-popup visible="{{statsFilterVisible}}" placement="bottom" t-class="dashboard-rounded-popup" t-class-content="dashboard-rounded-popup-content" bind:visible-change="onStatsFilterClose">
    <t-picker wx:if="{{statsFilterVisible}}" use-popup="{{false}}" value="{{statsFilterValue}}" title="{{statsFilterTitle}}" cancel-btn="取消" confirm-btn="确定" bind:confirm="onStatsFilterConfirm" bind:cancel="onStatsFilterClose" t-class="dashboard-picker">
      <t-picker-item options="{{statsFilterOptions}}" />
    </t-picker>
  </t-popup>
  <app-tab-bar value="mine" page="dashboard" />
</view>
<common-dialog id="common-dialog" />
