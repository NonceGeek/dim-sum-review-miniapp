/* pages/others/others.wxss */

.page {
  background-color: var(--bg-page);
  color: var(--text-primary);
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
}

/* ============================================
   TDesign Tabs 样式
   ============================================ */
.t-tabs {
  background-color: var(--bg-card) !important;
  border: none !important;
  border-bottom: none !important;
}

/* ============================================
   搜索框样式
   ============================================ */
.search-wrapper {
  position: sticky;
  top: 88rpx;
  z-index: 998;
  padding: 24rpx 24rpx 24rpx 24rpx;
  background-color: var(--bg-page);
  border: none !important;
}

/* 搜索框输入框样式 */
.search-placeholder {
  background: var(--bg-input) !important;
  margin-bottom: 0;
}

/* 搜索框组件样式 */
.search-wrapper .t-search {
  border: none !important;
  border-bottom: none !important;
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.search-wrapper .t-search::after {
  display: none !important;
  height: 0 !important;
  border-bottom: none !important;
}

/* 深色模式下的搜索框样式 */
.theme-dark .search-wrapper .t-search {
  background: var(--bg-card) !important;
  border: none !important;
}

.theme-dark .search-wrapper .t-search::after,
.theme-dark .search-wrapper .t-search::before {
  display: none !important;
}

.theme-dark .search-wrapper .t-search .t-icon {
  color: var(--text-primary) !important;
}

.search-wrapper .t-search .t-search__input-box{
  background: var(--bg-card) !important;
  border-color: var(--border-color) !important;
}

.search-wrapper .t-search input {
  color: var(--text-primary) !important;
}

.theme-dark .search-wrapper .t-search input::placeholder {
  color: var(--bg-input) !important;
}

/* ============================================
   Content Wrapper 样式
   ============================================ */
.content-wrapper {
  padding: 24rpx;
  border: none !important;
  background-color: var(--bg-page);
}

/* TDesign Cell Group 样式 */
.custom-cell-group {
  margin: 0 12rpx;
  border: none !important;
}

/* 自定义 Cell 样式 */
.custom-cell {
  margin-bottom: 16rpx !important;
  border-radius: var(--radius-lg) !important;
  background-color: var(--bg-card) !important;
  box-shadow: var(--shadow-sm) !important;
  border: 1px solid var(--border-light) !important;
  overflow: hidden !important;
  transition: all 0.2s ease !important;
}

/* 去除 t-cell 下划线 */
.custom-cell::after {
  display: none !important;
}

.custom-cell:active {
  transform: scale(0.995);
  box-shadow: var(--shadow-md) !important;
}

/* Cell 左侧图标 */
.custom-cell .t-cell__left-icon {
  color: var(--primary) !important;
}

/* Cell 标题 */
.custom-cell .t-cell__title {
  color: var(--text-primary) !important;
  font-weight: 500 !important;
  font-size: 32rpx !important;
}

/* Cell 箭头 */
.custom-cell .t-cell__right-icon {
  color: var(--text-placeholder) !important;
}

.custom-cell .t-cell__title {
  color: var(--text-primary) !important;
}

.custom-cell .t-cell__note {
  color: var(--text-secondary) !important;
}

.custom-cell .t-cell__left-icon {
  color: var(--primary) !important;
}

/* ============================================
   加载更多按钮
   ============================================ */
.more-view {
  padding: 32rpx 0;
  display: flex;
  justify-content: center;
}

.more-view .btn-type {
  min-width: 200rpx;
}

/* ============================================
   空状态容器
   ============================================ */
.container {
  height: 60vh;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  background-color: var(--bg-page);
}

.container .t-empty__description {
  color: var(--text-secondary) !important;
}

/* ============================================
   深色模式适配
   ============================================ */
@media (prefers-color-scheme: dark) {
  page {
    background-color: var(--bg-page);
  }
}

/* 与 index 相同的任务卡片样式 */
.task-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
}

.task-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.task-card-tag {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background-color: var(--bg-input);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.task-card-corpus {
  margin-bottom: 10rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.task-card-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.task-card-context,
.task-card-hint {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.task-card-hover {
  background-color: var(--bg-input);
}

.task-card-tag-classification_check {
  color: #00875f;
  background-color: rgba(0, 168, 112, 0.12);
}
.task-card-tag-content_review {
  color: #d97706;
  background-color: rgba(245, 158, 11, 0.14);
}
.theme-dark .task-card-tag-classification_check { color: #5fd4ac; }
.theme-dark .task-card-tag-content_review { color: #f5b35c; }

.container-wrap {
  --td-tab-border-color: transparent;
}
.others-filter-tabs.others-filter-tabs::after { display: none !important; }
